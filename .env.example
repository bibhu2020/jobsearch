# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
# SQLite fallback used by Python agents only
DATABASE_PATH=./shared/job_tracker.db

# ── File storage ──────────────────────────────────────────────────────────────
ARTIFACTS_PATH=./artifacts
SEARCH_RESULTS_PATH=./search_results

# ── Gateway (NestJS) ──────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
AGENTS_URL=http://localhost:8000

# ── AI keys (required) ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...

# ── AI provider routing (optional) ───────────────────────────────────────────
# Values: "google" or "openai"
AI_PRIMARY_PROVIDER=google
AI_FALLBACK_PROVIDER=openai
# Model overrides (optional — defaults shown)
GOOGLE_AI_MODEL=gemma-4
OPENAI_MODEL=gpt-4o

# ── GitHub artifact storage ───────────────────────────────────────────────────
# Create a classic PAT at github.com/settings/tokens with 'repo' scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_ARTIFACTS_PATH=https://github.com/owner/repo/path
GITHUB_BRANCH=main

# ── Auto-apply ────────────────────────────────────────────────────────────────
# Encrypts stored job-portal passwords, Gmail tokens and site sessions.
# Generate with: openssl rand -base64 32
CREDENTIALS_ENC_KEY=
# Gmail (read-only) for email verification — Google Cloud OAuth "Web application" client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
# Concurrent browser runs per container, and headless mode (false = watch Chromium locally)
APPLY_MAX_CONCURRENCY=2
APPLY_HEADLESS=true

# ---
CREDENTIALS_ENC_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=# Limits (all users share one container and one outbound IP)
APPLY_USER_DAILY_LIMIT=25        # applications a user can start per 24 h
APPLY_MAX_PENDING_RUNS=10        # unfinished applications across all users before new starts are refused
EASY_APPLY_GLOBAL_DAILY_CAP=40   # LinkedIn/Indeed Easy Apply submissions across all users per 24 h
